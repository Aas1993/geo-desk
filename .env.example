# Market data vendor (prices, fundamentals, statements) — https://twelvedata.com
# ADX and DFM publish no public data feed, so quotes come from this licensed vendor. Without a key the
# markets pages still list every ADX/DFM stock and show DFM filings, but prices/indicators show "not connected".
TWELVEDATA_API_KEY=
# Requests per minute allowed by your plan (free = 8). Raise it on paid plans so the board loads faster.
TWELVEDATA_RPM=8
# Dev only: synthetic, clearly-labelled test data so the UI can be developed without a key. Ignored in production.
# GD_FIXTURES=1

# AI research tab. Credentials resolve in this order: ANTHROPIC_API_KEY, ANTHROPIC_AUTH_TOKEN, or your `ant auth login` profile
# (a profile is already active on this machine, so nothing is needed in dev). Each note bills your Anthropic account.
# ANTHROPIC_API_KEY=
# RESEARCH_MODEL=claude-opus-5-5     # default; claude-sonnet-5-5 is cheaper with web research
# RESEARCH_ENABLED=0                 # set to 0 to switch the feature off
